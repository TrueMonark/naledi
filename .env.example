# ─────────────────────────────────────────────────────────────────────────────
#  Naledi School website — settings for running LOCALLY on your computer
#
#  1. Copy this file to ".env" in the same folder (PowerShell):
#        Copy-Item .env.example .env
#  2. Fill in the values below in .env (not in this file).
#  3. Save .env as UTF-8 (VS Code / Notepad default).
#  Never share or commit your real .env — it holds passwords.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database (required) ──────────────────────────────────────────────────────
# Your local PostgreSQL. Format:
#   postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?schema=public
# The database must already exist (create it in pgAdmin: Databases → Create → Database).
# Use a NEW, empty database for this version — not the old site's database.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/ns_db?schema=public"
# …or, instead of DATABASE_URL, give the parts separately (handy in hosting panels; passwords
# with symbols like @ # / : are handled safely):
# DB_HOST="localhost"
# DB_PORT="5432"
# DB_NAME="ns_db"
# DB_USER="postgres"
# DB_PASSWORD=""


# ── Admin login (required) ───────────────────────────────────────────────────
# Secret used to sign admin logins. Any long random text. To generate one, run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# The first admin account, created when you run:  npm run db:seed
# (Change the password later in Admin → Account & Users.)
ADMIN_EMAIL="admin@naledischool.org"
ADMIN_PASSWORD=""
ADMIN_NAME="Site Administrator"


# ── Local running ────────────────────────────────────────────────────────────
# Address of the site. Locally this is http://localhost:3000.
# When the site goes online, change it to the real address (e.g. https://naledischool.org)
# so Facebook posts can include a "Read more" link back to the article.
SITE_URL="http://localhost:3000"

# "false" lets you log in over plain http — needed locally, and when opening the site
# from another device on your network (e.g. http://192.168.1.20:3000).
# Remove this line (or set "true") once the site runs on https.
COOKIE_SECURE="false"


# ── Uploads ──────────────────────────────────────────────────────────────────
# Folder where uploaded photos, videos and PDFs are saved. Empty = "uploads" inside the project.
# Example of a custom Windows folder:  UPLOAD_DIR="C:\NalediUploads"
UPLOAD_DIR=""
# Maximum upload sizes in MB (photos are automatically resized after upload)
MAX_IMAGE_MB=20
MAX_VIDEO_MB=200


# ── Facebook Page sharing (optional — leave empty until you have your token) ─
# Lets admins share News posts to the school's Facebook PAGE.
# Step-by-step guide: docs/facebook-setup.md
# After filling these in, stop the site (Ctrl+C) and start it again (npm run dev).
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
# Graph API version — leave as is unless the guide tells you otherwise
FACEBOOK_GRAPH_VERSION="v26.0"


# ── Contact form email (optional) ────────────────────────────────────────────
# Messages are always saved in Admin → Messages. Fill these in to ALSO get an email.
# Gmail example: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_USER = your Gmail,
# SMTP_PASS = a Gmail "App password" (not your normal password).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
CONTACT_NOTIFY_EMAIL=""
